# ─── Dependencies ────────────────────────────────────────────────
node_modules/

# ─── Build outputs ───────────────────────────────────────────────
dist/
build/
.next/
out/

# ─── TypeScript ──────────────────────────────────────────────────
*.tsbuildinfo
# Regenerated by `next dev` / `next build` / `next typegen`
next-env.d.ts

# ─── Environment variables ───────────────────────────────────────
.env
.env.*
!.env.example

# ─── Generated code ──────────────────────────────────────────────
# The Prisma client is regenerated on every `pnpm install` (see
# web/db/package.json's postinstall), so it isn't committed. schema.prisma
# and prisma/migrations/ ARE committed.
web/db/src/__generated__/

# ─── Logs ────────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
pnpm-debug.log*

# ─── Testing & Coverage ──────────────────────────────────────────
coverage/

# ─── OS & Editor artifacts ───────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp
*.swo
