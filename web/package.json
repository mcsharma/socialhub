{
  "name": "socialhub",
  "private": true,
  "type": "module",
  "description": "SocialHub web workspace: Next.js app (main) + Prisma data layer (db)",
  "scripts": {
    "dev": "pnpm --filter @socialhub/main dev",
    "build": "pnpm -r build",
    "start": "pnpm --filter @socialhub/main start",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "db:migrate": "pnpm --filter @socialhub/db migrate",
    "db:generate": "pnpm --filter @socialhub/db generate",
    "db:seed": "pnpm --filter @socialhub/db seed",
    "db:reset": "pnpm --filter @socialhub/db reset",
    "db:studio": "pnpm --filter @socialhub/db studio",
    "format": "prettier --write . ../.vscode ../docker-compose.yml ../.prettierrc.json",
    "format:check": "prettier --check . ../.vscode ../docker-compose.yml ../.prettierrc.json"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.7",
    "eslint": "^10.15.0",
    "eslint-config-next": "16.4.6",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0"
  },
  "packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b",
  "engines": {
    "node": ">=24"
  }
}
