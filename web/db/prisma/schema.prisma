// web/db/prisma/schema.prisma
//
// Conventions
// - Model fields are camelCase; columns are snake_case via @map; tables are
//   plural snake_case via @@map.
// - Every primary key is a Snowflake ID minted by the Postgres function
//   `next_id()` (created in the first migration — see the "IDs" section of
//   the root README for the bit layout and generator-ID ranges).
//   - Domain tables store it as BIGINT (`BigInt` in Prisma / JS).
//   - Better Auth's tables (users/sessions/accounts/verifications) store the
//     same value as TEXT, because Better Auth JSON-serializes these rows and
//     JS BigInt isn't JSON-serializable. Same ID shape everywhere, only the
//     column type differs. Better Auth is configured with
//     `generateId: false`, so it leaves IDs to these column defaults.

generator client {
  provider = "prisma-client"
  output   = "../src/__generated__/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Better Auth core tables ──────────────────────────────────────────────
// Field names must match what Better Auth expects (it talks to Prisma by
// model/field name); column/table names are free to follow our conventions.

model User {
  id            String   @id @default(dbgenerated("(next_id())::text"))
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false) @map("email_verified")
  image         String?
  // Additional field (declared in main's Better Auth config); derived from
  // the email on sign-up by a databaseHook, used in /u/[username] URLs.
  username      String   @unique
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  sessions          Session[]
  accounts          Account[]
  circlesCreated    Circle[]       @relation("CircleCreator")
  circleMemberships CircleMember[] @relation("CircleMember")
  membersAdded      CircleMember[] @relation("CircleMemberAddedBy")
  posts             Post[]
  media             Media[]
  reactions         Reaction[]
  comments          Comment[]

  @@map("users")
}

model Session {
  id        String   @id @default(dbgenerated("(next_id())::text"))
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(dbgenerated("(next_id())::text"))
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(dbgenerated("(next_id())::text"))
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}

// ─── Circles ──────────────────────────────────────────────────────────────
// A circle is a private group; its feed is every member's posts, newest
// first. Circles are secret: only members can see them or their posts.
// Every member has the same permissions (no owner/admin), and any member can
// add someone.
//
// Product rule (enforced in the app, NOT here): a user is in at most one
// circle for now. The schema already allows many, so lifting the rule needs
// no migration.

model Circle {
  id          BigInt   @id @default(dbgenerated("next_id()"))
  name        String
  // Null if the creator's account is deleted; creators have no special
  // rights, so the circle lives on.
  createdById String?  @map("created_by_id")
  createdBy   User?    @relation("CircleCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  members         CircleMember[]
  posts           Post[]
  feedbackTargets FeedbackTarget[]

  @@map("circles")
}

model CircleMember {
  circleId  BigInt   @map("circle_id")
  userId    String   @map("user_id")
  // Who added this member. Null for the circle's creator, and if the adder's
  // account is deleted.
  addedById String?  @map("added_by_id")
  joinedAt  DateTime @default(now()) @map("joined_at")
  circle    Circle   @relation(fields: [circleId], references: [id], onDelete: Cascade)
  user      User     @relation("CircleMember", fields: [userId], references: [id], onDelete: Cascade)
  addedBy   User?    @relation("CircleMemberAddedBy", fields: [addedById], references: [id], onDelete: SetNull)

  @@id([circleId, userId])
  @@index([userId]) // "which circles is this user in?"
  @@map("circle_members")
}

// ─── Feedback targets ─────────────────────────────────────────────────────
// Anything people can react to or comment on (posts, comments; later photos,
// polls, …) owns one feedback target. Reactions and comments attach to the
// target, never to posts or comments directly, so they're implemented once
// and work on every type.
//
// - Each owning table has its own ID plus a unique `target_id` pointing here.
//   Adding a type = a `target_id` column on its table, a `FeedbackTargetType`
//   value, and one `owner…` back-relation line below (Prisma-only, no column).
// - `circle_id` makes permission checks one lookup for every type: you can see
//   a target iff you're in its circle.
// - Counts are maintained by Postgres triggers (see the feedback_targets
//   migration) — never written by app code.
// - Deleting a post or comment deletes its target (trigger), which cascades
//   to its reactions and the comments on it.
// - In code, use findFeedbackTarget() (web/db), which returns a typed `owner`
//   union instead of the per-type owner relations.

enum FeedbackTargetType {
  POST
  COMMENT

  @@map("feedback_target_type")
}

model FeedbackTarget {
  id            BigInt             @id @default(dbgenerated("next_id()"))
  targetType    FeedbackTargetType @map("target_type")
  circleId      BigInt             @map("circle_id")
  reactionCount Int                @default(0) @map("reaction_count")
  // Direct comments only (for a post: top-level comments, not replies).
  commentCount  Int                @default(0) @map("comment_count")
  createdAt     DateTime           @default(now()) @map("created_at")
  circle        Circle             @relation(fields: [circleId], references: [id], onDelete: Cascade)

  // The object this target belongs to — exactly one is set, per targetType.
  ownerPost    Post?    @relation("TargetOwner")
  ownerComment Comment? @relation("TargetOwner")

  // Feedback left on it.
  comments  Comment[]  @relation("CommentsOnTarget")
  reactions Reaction[]

  @@map("feedback_targets")
}

// ─── Posts ────────────────────────────────────────────────────────────────

model Post {
  // Snowflake IDs are time-ordered, so `ORDER BY id DESC` is newest-first
  // and `WHERE id < :cursor` is keyset pagination — no created_at index
  // needed for the feed.
  id        BigInt         @id @default(dbgenerated("next_id()"))
  circleId  BigInt         @map("circle_id")
  authorId  String         @map("author_id")
  // This post's feedback target (its reactions and comments).
  targetId  BigInt         @unique @map("target_id")
  // Null for photo-only posts. The app requires a body or at least one photo.
  body      String?
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  circle    Circle         @relation(fields: [circleId], references: [id], onDelete: Cascade)
  author    User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  target    FeedbackTarget @relation("TargetOwner", fields: [targetId], references: [id], onDelete: Cascade)

  media PostMedia[]

  @@index([circleId, id(sort: Desc)]) // circle feed
  @@index([authorId, id(sort: Desc)]) // profile
  @@map("posts")
}

// ─── Media ────────────────────────────────────────────────────────────────
// Uploaded first, then attached to a post (via post_media) when the post is
// created. Photos are processed at upload (EXIF stripped, rotated, resized to
// fixed WebP sizes) and stored in object storage under `storageKey`, a
// random, unguessable prefix — circles are secret, so keys must not be
// enumerable. Videos will be added as another MediaKind.

enum MediaKind {
  PHOTO

  @@map("media_kind")
}

model Media {
  id         BigInt    @id @default(dbgenerated("next_id()"))
  uploaderId String    @map("uploader_id")
  kind       MediaKind
  storageKey String    @unique @map("storage_key")
  mimeType   String    @map("mime_type")
  // Dimensions of the largest stored size, for layout before the image loads.
  width      Int
  height     Int
  sizeBytes  Int       @map("size_bytes")
  createdAt  DateTime  @default(now()) @map("created_at")
  uploader   User      @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  post PostMedia?

  @@index([uploaderId])
  @@map("media")
}

model PostMedia {
  postId   BigInt @map("post_id")
  mediaId  BigInt @unique @map("media_id") // a media item belongs to one post
  position Int // 0-based order within the post; the app allows up to 10
  post     Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  media    Media  @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([postId, mediaId])
  @@unique([postId, position])
  @@map("post_media")
}

// ─── Reactions ────────────────────────────────────────────────────────────

enum ReactionType {
  LIKE
  LOVE
  HAHA
  SAD
  ANGRY

  @@map("reaction_type")
}

model Reaction {
  targetId  BigInt         @map("target_id")
  userId    String         @map("user_id")
  type      ReactionType
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  target    FeedbackTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One reaction per person per target; changing it updates `type`.
  @@id([targetId, userId])
  @@index([userId])
  @@map("reactions")
}

// ─── Comments ─────────────────────────────────────────────────────────────
// A comment is left on a feedback target (a post's, or another comment's
// for a reply) and owns a target of its own, so it can be reacted to and
// replied to. The app allows two levels: comments on posts, and replies to
// those comments.

model Comment {
  id             BigInt         @id @default(dbgenerated("next_id()"))
  // This comment's own feedback target (its reactions and replies).
  targetId       BigInt         @unique @map("target_id")
  // The target it was left on.
  parentTargetId BigInt         @map("parent_target_id")
  authorId       String         @map("author_id")
  body           String
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  target         FeedbackTarget @relation("TargetOwner", fields: [targetId], references: [id], onDelete: Cascade)
  parentTarget   FeedbackTarget @relation("CommentsOnTarget", fields: [parentTargetId], references: [id], onDelete: Cascade)
  author         User           @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([parentTargetId, id]) // comments on a target, oldest first
  @@index([authorId])
  @@map("comments")
}
