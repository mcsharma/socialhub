{
  "name": "@socialhub/db",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Prisma schema, migrations, client and pure (framework-free) query functions",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "postinstall": "pnpm run generate",
    "generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "migrate:create": "prisma migrate dev --create-only",
    "migrate:deploy": "prisma migrate deploy",
    "reset": "prisma migrate reset",
    "seed": "prisma db seed",
    "studio": "prisma studio",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "better-auth": "^1.7.25",
    "dotenv": "^18.0.10",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
