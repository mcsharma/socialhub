# web/.env.example — copy to web/.env and fill in.
#
# ONE env file for the whole web workspace: web/db's prisma.config.ts and
# web/main's next.config.ts both load this file, so DATABASE_URL lives in
# exactly one place.

# Postgres connection string. This default matches the repo-root
# docker-compose.yml exactly (note port 5433) — `docker compose up -d` and it
# works as-is.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/socialhub"

# Better Auth — signs session cookies. Any long random string; generate one
# with: openssl rand -base64 32
BETTER_AUTH_SECRET="dev-only-secret-change-me-dev-only-secret-change-me"
# The app's public origin (where Better Auth's /api/auth/* routes live).
BETTER_AUTH_URL="http://localhost:3000"

# Google sign-in (optional). Leave blank to run with email/password only —
# the "Continue with Google" button hides itself when these are empty.
# Create an OAuth client at Google Cloud Console > Google Auth Platform >
# Clients, with authorized redirect URI:
#   http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
